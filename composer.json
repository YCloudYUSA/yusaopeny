        "drupal/gemini_provider",
        "drupal/jquery_ui",
        "drupal/layout_builder_operation_link",
        "drupal/plugin",
        "drupal/responsive_favicons"
      ]
    },
    "drupal-scaffold": {
      "allowed-packages": [
        "drupal/core"
      ],
      "locations": {
        "web-root": "docroot/"
      }
    },
    "installer-paths": {
      "docroot/core": [
        "type:drupal-core"
      ],
      "docroot/modules/contrib/{$name}": [
        "type:drupal-module"
      ],
      "docroot/profiles/contrib/{$name}": [
        "type:drupal-profile"
      ],
      "docroot/themes/contrib/{$name}": [
        "type:drupal-theme"
      ],
      "docroot/libraries/{$name}": [
        "type:drupal-library",
        "type:bower-asset",
        "type:npm-asset"
      ],
      "docs/": [
        "open-y-subprojects/openy_docs"
      ]
    },
    "installer-types": [
      "openy-docs"
    ],
