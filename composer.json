  "extra": {
    "drupal-lenient": {
      "allowed-list": [
        "drupal/address",
        "drupal/addtoany",
        "drupal/ai",
        "drupal/datalayer",
        "drupal/date_augmenter",
        "drupal/editor_advanced_link",
