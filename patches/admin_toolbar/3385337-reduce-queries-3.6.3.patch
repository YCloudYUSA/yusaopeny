+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\admin_toolbar_tools\Unit\Plugin\Derivative;
+
+use Drupal\Core\Config\ConfigFactoryInterface;
+use Drupal\Core\Config\ImmutableConfig;
+use Drupal\Core\Entity\EntityStorageInterface;
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Drupal\Core\Extension\ModuleHandlerInterface;
+use Drupal\Core\Extension\ThemeHandlerInterface;
+use Drupal\Core\Routing\RouteProviderInterface;
+use Drupal\Core\Session\AccountInterface;
+use Drupal\Tests\UnitTestCase;
+use Drupal\admin_toolbar_tools\Plugin\Derivative\ExtraLinks;
+use Symfony\Component\Routing\Route;
+use PHPUnit\Framework\Attributes\IgnoreDeprecations;
+
+/**
+ * Tests the route existence cache in the ExtraLinks deriver.
+ *
+ * @coversDefaultClass \Drupal\admin_toolbar_tools\Plugin\Derivative\ExtraLinks
+ * @group admin_toolbar
+ * @group admin_toolbar_tools
+ */
+#[IgnoreDeprecations]
+class ExtraLinksTest extends UnitTestCase {
+
+  /**
+   * Creates an ExtraLinks deriver backed by the given route provider.
+   */
+  protected function createExtraLinks(RouteProviderInterface $route_provider): ExtraLinks {
+    return new ExtraLinks(
+      $this->createMock(EntityTypeManagerInterface::class),
+      $this->createMock(ModuleHandlerInterface::class),
+      $route_provider,
+      $this->createMock(ThemeHandlerInterface::class),
+      $this->createMock(ConfigFactoryInterface::class),
+      $this->createMock(AccountInterface::class),
+    );
+  }
+
+  /**
+   * @covers ::routeExists
+   */
+  public function testRouteExistsReturnsTrueForKnownRoute(): void {
+    $route_provider = $this->createMock(RouteProviderInterface::class);
+    $route_provider->expects($this->once())
+      ->method('getAllRoutes')
+      ->willReturn(['entity.node.canonical' => new Route('/node/{node}')]);
+
+    $extra_links = $this->createExtraLinks($route_provider);
+
+    $this->assertTrue($extra_links->routeExists('entity.node.canonical'));
+  }
+
+  /**
+   * @covers ::routeExists
+   */
+  public function testRouteExistsReturnsFalseForUnknownRoute(): void {
+    $route_provider = $this->createMock(RouteProviderInterface::class);
+    $route_provider->expects($this->once())
+      ->method('getAllRoutes')
+      ->willReturn(['entity.node.canonical' => new Route('/node/{node}')]);
+
+    $extra_links = $this->createExtraLinks($route_provider);
+
+    $this->assertFalse($extra_links->routeExists('entity.does_not_exist.canonical'));
+  }
+
+  /**
+   * @covers ::routeExists
+   * @covers ::preloadRouteCache
+   */
+  public function testRouteExistsOnlyLoadsRoutesOnce(): void {
+    $route_provider = $this->createMock(RouteProviderInterface::class);
+    $route_provider->expects($this->once())
+      ->method('getAllRoutes')
+      ->willReturn([
+        'entity.node.canonical' => new Route('/node/{node}'),
+        'entity.node.edit_form' => new Route('/node/{node}/edit'),
+      ]);
+
+    $extra_links = $this->createExtraLinks($route_provider);
+
+    // Call routeExists() many times, for both existing and missing
+    // routes. getAllRoutes() must only be invoked once (asserted above
+    // via expects($this->once())), regardless of how many times
+    // routeExists() is called.
+    for ($i = 0; $i < 10; $i++) {
+      $this->assertTrue($extra_links->routeExists('entity.node.canonical'));
+      $this->assertTrue($extra_links->routeExists('entity.node.edit_form'));
+      $this->assertFalse($extra_links->routeExists('entity.node.delete_form'));
+    }
+  }
+
+  /**
+   * Tests the route cache does not outlive a single derivative build.
+   *
+   * @covers ::getDerivativeDefinitions
+   * @covers ::routeExists
+   */
+  public function testRouteCacheIsResetForEachDerivativeBuild(): void {
+    // The route only exists for the second build, as if the router was rebuilt
+    // in between during the same request.
+    $route_provider = $this->createMock(RouteProviderInterface::class);
+    $route_provider->expects($this->exactly(2))
+      ->method('getAllRoutes')
+      ->willReturnOnConsecutiveCalls(
+        [],
+        ['project_browser.browse' => new Route('/admin/modules/browse/{source}')],
+      );
+
+    $config = $this->createMock(ImmutableConfig::class);
+    $config->method('get')->willReturnCallback(
+      fn (string $key) => $key === 'enabled_sources' ? ['source_a' => []] : NULL,
+    );
+    $config_factory = $this->createMock(ConfigFactoryInterface::class);
+    $config_factory->method('get')->willReturn($config);
+
+    $module_handler = $this->createMock(ModuleHandlerInterface::class);
+    $module_handler->method('moduleExists')
+      ->willReturnCallback(fn (string $module) => $module === 'project_browser');
+
+    $entity_type_manager = $this->createMock(EntityTypeManagerInterface::class);
+    $entity_type_manager->method('getDefinitions')->willReturn([]);
+    $storage = $this->createMock(EntityStorageInterface::class);
+    $storage->method('loadMultiple')->willReturn([]);
+    $storage->method('loadByProperties')->willReturn([]);
+    $entity_type_manager->method('getStorage')->willReturn($storage);
+
+    $theme_handler = $this->createMock(ThemeHandlerInterface::class);
+    $theme_handler->method('listInfo')->willReturn([]);
+
+    $extra_links = new ExtraLinks(
+      $entity_type_manager,
+      $module_handler,
+      $route_provider,
+      $theme_handler,
+      $config_factory,
+      $this->createMock(AccountInterface::class),
+    );
+    $extra_links->setStringTranslation($this->getStringTranslationStub());
+
+    $base_plugin_definition = ['id' => 'admin_toolbar_tools.extra_links'];
+    $this->assertArrayNotHasKey('project_browser.browse.source_a', $extra_links->getDerivativeDefinitions($base_plugin_definition));
+    $this->assertArrayHasKey('project_browser.browse.source_a', $extra_links->getDerivativeDefinitions($base_plugin_definition));
+  }
+
+}
