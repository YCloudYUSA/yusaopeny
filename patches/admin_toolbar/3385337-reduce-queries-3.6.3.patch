diff --git a/admin_toolbar_tools/src/MenuLinkRebuildManager.php b/admin_toolbar_tools/src/MenuLinkRebuildManager.php
new file mode 100644
index 0000000000000000000000000000000000000000..115cfbfc03795a1f43656ea1a321d28e2f01f33e
--- /dev/null
+++ b/admin_toolbar_tools/src/MenuLinkRebuildManager.php
@@ -0,0 +1,144 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\admin_toolbar_tools;
+
+use Drupal\Core\DestructableInterface;
+use Drupal\Core\Menu\MenuLinkManagerInterface;
+use Symfony\Component\EventDispatcher\EventDispatcherInterface;
+use Symfony\Component\HttpKernel\Event\ResponseEvent;
+use Symfony\Component\HttpKernel\KernelEvents;
+
+/**
+ * Defers menu link rebuilds, coalescing multiple requests into one rebuild.
+ *
+ * Entity hooks in admin_toolbar_tools trigger menu link rebuilds when
+ * relevant entities (menus, roles, views, bundle types) are created,
+ * updated, or deleted. During module installation, hundreds of config
+ * entities may be created in sequence, each triggering a full rebuild.
+ * This service collects those requests and performs a single rebuild
+ * instead.
+ *
+ * The rebuild is flushed at the earliest of two points:
+ * - The 'kernel.response' event, which fires before the response is sent
+ *   to the client. This ensures interactive requests (e.g. saving a role
+ *   or menu through a form, which redirects afterwards) always see fresh
+ *   menu links on the very next page load, with no race condition.
+ * - Request termination, via DestructableInterface. This is a fallback
+ *   for contexts that never dispatch 'kernel.response' (e.g. Drush/CLI),
+ *   where Drupal still guarantees destruct() is called.
+ *
+ * Unlike a statically tagged 'event_subscriber', the 'kernel.response'
+ * listener is only registered on demand, the first time requestRebuild()
+ * is actually called. This means requests that never save a tracked
+ * entity type (e.g. anonymous, Page Cache-served page views) never
+ * instantiate this service or touch the event dispatcher at all.
+ *
+ * Both flush paths call the same logic, and the internal flag is reset
+ * once a rebuild has run, so it is safe for both to fire in the same
+ * request.
+ *
+ * @internal
+ */
+class MenuLinkRebuildManager implements DestructableInterface {
+
+  /**
+   * Whether a menu link rebuild has been requested.
+   *
+   * @var bool
+   */
+  protected bool $needsRebuild = FALSE;
+
+  /**
+   * Whether the 'kernel.response' listener has been registered.
+   *
+   * @var bool
+   */
+  protected bool $listenerRegistered = FALSE;
+
+  /**
+   * The menu link manager.
+   *
+   * @var \Drupal\Core\Menu\MenuLinkManagerInterface
+   */
+  protected MenuLinkManagerInterface $menuLinkManager;
+
+  /**
+   * The event dispatcher.
+   *
+   * @var \Symfony\Component\EventDispatcher\EventDispatcherInterface
+   */
+  protected EventDispatcherInterface $eventDispatcher;
+
+  /**
+   * Constructs a MenuLinkRebuildManager object.
+   *
+   * @param \Drupal\Core\Menu\MenuLinkManagerInterface $menu_link_manager
+   *   The menu link manager.
+   * @param \Symfony\Component\EventDispatcher\EventDispatcherInterface $event_dispatcher
+   *   The event dispatcher.
+   */
+  public function __construct(MenuLinkManagerInterface $menu_link_manager, EventDispatcherInterface $event_dispatcher) {
+    $this->menuLinkManager = $menu_link_manager;
+    $this->eventDispatcher = $event_dispatcher;
+  }
+
+  /**
+   * Marks that a menu link rebuild is needed.
+   *
+   * On the first call within a request, this also registers a
+   * 'kernel.response' listener so the rebuild is flushed before the
+   * response is sent to the client.
+   */
+  public function requestRebuild(): void {
+    $this->needsRebuild = TRUE;
+    if (!$this->listenerRegistered) {
+      $this->listenerRegistered = TRUE;
+      $this->eventDispatcher->addListener(KernelEvents::RESPONSE, [$this, 'onKernelResponse']);
+    }
+  }
+
+  /**
+   * Rebuilds the menu links immediately and clears any pending request.
+   *
+   * Meant for explicit user actions (e.g. flushing the menu or saving the
+   * module settings), so the deferred rebuild does not run a second time at
+   * the end of the request.
+   */
+  public function rebuildNow(): void {
+    $this->needsRebuild = FALSE;
+    $this->menuLinkManager->rebuild();
+  }
+
+  /**
+   * Performs the rebuild if one has been requested.
+   */
+  protected function flushIfNeeded(): void {
+    if ($this->needsRebuild) {
+      $this->rebuildNow();
+    }
+  }
+
+  /**
+   * Flushes a pending rebuild before the response is sent to the client.
+   *
+   * Ignores subrequests (e.g. ESI/render subrequests), which do not
+   * correspond to a response actually being delivered to the client.
+   */
+  public function onKernelResponse(ResponseEvent $event): void {
+    // Drupal 9.5 (Symfony 4.4) has neither isMainRequest() nor the MAIN_REQUEST
+    // constant, only MASTER_REQUEST: they all have the value 1.
+    if ($event->getRequestType() === 1) {
+      $this->flushIfNeeded();
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function destruct(): void {
+    $this->flushIfNeeded();
+  }
+
+}
