diff --git a/admin_toolbar_tools/tests/src/Kernel/MenuLinkRebuildManagerIntegrationTest.php b/admin_toolbar_tools/tests/src/Kernel/MenuLinkRebuildManagerIntegrationTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..8883fb53ed44bfc1d53064be0e0f287ede98049f
--- /dev/null
+++ b/admin_toolbar_tools/tests/src/Kernel/MenuLinkRebuildManagerIntegrationTest.php
@@ -0,0 +1,138 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\admin_toolbar_tools\Kernel;
+
+use Drupal\KernelTests\KernelTestBase;
+use Drupal\user\Entity\Role;
+use Drupal\user\Entity\User;
+use Symfony\Component\HttpFoundation\Request;
+use Symfony\Component\HttpFoundation\Response;
+use Symfony\Component\HttpKernel\Event\ResponseEvent;
+use Symfony\Component\HttpKernel\HttpKernelInterface;
+use Symfony\Component\HttpKernel\KernelEvents;
+use PHPUnit\Framework\Attributes\IgnoreDeprecations;
+
+/**
+ * Tests the end-to-end wiring of the deferred menu link rebuild.
+ *
+ * Unlike \Drupal\Tests\admin_toolbar_tools\Unit\MenuLinkRebuildManagerTest,
+ * which exercises the service in isolation with mocked collaborators, this
+ * test uses the real service container and real entity hooks to confirm
+ * that admin_toolbar_tools_entity_insert()/_update()/_delete() correctly
+ * resolve and call the 'admin_toolbar_tools.menu_link_rebuild_manager'
+ * service, and that the rebuild is deferred until either the
+ * 'kernel.response' event or destruct() (request termination) runs.
+ *
+ * @group admin_toolbar
+ * @group admin_toolbar_tools
+ */
+#[IgnoreDeprecations]
+class MenuLinkRebuildManagerIntegrationTest extends KernelTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'system',
+    'user',
+    'admin_toolbar_tools',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->installConfig(['admin_toolbar_tools']);
+  }
+
+  /**
+   * Reads the protected $needsRebuild flag off the rebuild manager service.
+   *
+   * The service intentionally exposes no public getter for this internal
+   * state, since production code has no need for one. Reflection is used
+   * here purely for test observability of the real, container-resolved
+   * singleton.
+   */
+  protected function needsRebuild(object $manager): bool {
+    $property = new \ReflectionProperty($manager, 'needsRebuild');
+    return $property->getValue($manager);
+  }
+
+  /**
+   * Tests that saving tracked entities defers the rebuild until destruct().
+   */
+  public function testEntitySavesDeferRebuildUntilDestruct(): void {
+    $manager = \Drupal::service('admin_toolbar_tools.menu_link_rebuild_manager');
+    $this->assertFalse($this->needsRebuild($manager), 'No rebuild is needed before any relevant entity is saved.');
+
+    // 'user_role' is one of the entity types tracked by
+    // AdminToolbarToolsHelper::getRebuildEntityTypes(), so saving one
+    // should trigger admin_toolbar_tools_entity_insert() and, in turn,
+    // requestRebuild() on the real container-resolved service.
+    Role::create(['id' => 'test_role_1', 'label' => 'Test role 1'])->save();
+    $this->assertTrue($this->needsRebuild($manager), 'Saving a tracked entity type requests a rebuild.');
+
+    // Saving a second tracked entity before destruct() confirms the hooks
+    // keep resolving and flagging the same singleton service, without
+    // performing the rebuild itself yet.
+    Role::create(['id' => 'test_role_2', 'label' => 'Test role 2'])->save();
+    $this->assertTrue($this->needsRebuild($manager));
+
+    $manager->destruct();
+    $this->assertFalse($this->needsRebuild($manager), 'The flag is reset once the deferred rebuild has run.');
+  }
+
+  /**
+   * Tests that the service is really wired to the kernel.response event.
+   *
+   * This confirms that requestRebuild() actually registers a listener on
+   * the real, compiled event dispatcher (not just a mock), so a
+   * main-request response flushes a pending rebuild before it reaches
+   * the client.
+   */
+  public function testKernelResponseEventFlushesRebuildOnRealDispatcher(): void {
+    $manager = \Drupal::service('admin_toolbar_tools.menu_link_rebuild_manager');
+    Role::create(['id' => 'test_role_3', 'label' => 'Test role 3'])->save();
+    $this->assertTrue($this->needsRebuild($manager));
+
+    $event = new ResponseEvent(
+      $this->createMock(HttpKernelInterface::class),
+      Request::create('/'),
+      // The main request type has a different name before Symfony 5.3.
+      1,
+      new Response(),
+    );
+    \Drupal::service('event_dispatcher')->dispatch($event, KernelEvents::RESPONSE);
+
+    $this->assertFalse($this->needsRebuild($manager), 'The kernel.response event flushed the pending rebuild.');
+  }
+
+  /**
+   * Tests that saving an untracked entity type does not request a rebuild.
+   *
+   * Also confirms that no 'kernel.response' listener gets registered on
+   * the real event dispatcher in this case, since the listener is only
+   * attached on demand from within requestRebuild(). This is what keeps
+   * the vast majority of requests (which never save a tracked entity
+   * type) from touching this service or the event dispatcher at all.
+   */
+  public function testUnrelatedEntityTypeDoesNotRequestRebuild(): void {
+    $this->installEntitySchema('user');
+    $manager = \Drupal::service('admin_toolbar_tools.menu_link_rebuild_manager');
+    /** @var \Symfony\Component\EventDispatcher\EventDispatcherInterface $event_dispatcher */
+    $event_dispatcher = \Drupal::service('event_dispatcher');
+    $listeners_before = $event_dispatcher->getListeners(KernelEvents::RESPONSE);
+
+    // 'user' is a content entity type without bundles, so it is not part
+    // of AdminToolbarToolsHelper::getRebuildEntityTypes(); saving one
+    // should not mark a rebuild as needed.
+    User::create(['name' => 'test user'])->save();
+
+    $this->assertFalse($this->needsRebuild($manager));
+    $this->assertCount(count($listeners_before), $event_dispatcher->getListeners(KernelEvents::RESPONSE), 'No kernel.response listener was registered for an untracked entity type.');
+  }
+
+}
