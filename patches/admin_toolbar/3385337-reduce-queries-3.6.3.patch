+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\admin_toolbar_tools\Unit;
+
+use Drupal\Core\Menu\MenuLinkManagerInterface;
+use Drupal\Tests\UnitTestCase;
+use Drupal\admin_toolbar_tools\MenuLinkRebuildManager;
+use PHPUnit\Framework\Attributes\IgnoreDeprecations;
+use Symfony\Component\EventDispatcher\EventDispatcherInterface;
+use Symfony\Component\HttpFoundation\Request;
+use Symfony\Component\HttpFoundation\Response;
+use Symfony\Component\HttpKernel\Event\ResponseEvent;
+use Symfony\Component\HttpKernel\HttpKernelInterface;
+use Symfony\Component\HttpKernel\KernelEvents;
+
+/**
+ * Tests the deferred menu link rebuild manager.
+ *
+ * @coversDefaultClass \Drupal\admin_toolbar_tools\MenuLinkRebuildManager
+ * @group admin_toolbar
+ * @group admin_toolbar_tools
+ */
+#[IgnoreDeprecations]
+class MenuLinkRebuildManagerTest extends UnitTestCase {
+
+  /**
+   * The main request type (named MASTER_REQUEST before Symfony 5.3).
+   */
+  protected const MAIN_REQUEST = 1;
+
+  /**
+   * Creates a ResponseEvent for the given request type.
+   */
+  protected function createResponseEvent(int $requestType): ResponseEvent {
+    return new ResponseEvent(
+      $this->createMock(HttpKernelInterface::class),
+      Request::create('/'),
+      $requestType,
+      new Response(),
+    );
+  }
+
+  /**
+   * Tests that destruct() does nothing when no rebuild was requested.
+   *
+   * Also confirms the event dispatcher is never touched: a request that
+   * never saves a tracked entity type must not register any listener.
+   *
+   * @covers ::destruct
+   */
+  public function testDestructWithoutRequestDoesNotRebuild(): void {
+    $menuLinkManager = $this->createMock(MenuLinkManagerInterface::class);
+    $menuLinkManager->expects($this->never())->method('rebuild');
+    $eventDispatcher = $this->createMock(EventDispatcherInterface::class);
+    $eventDispatcher->expects($this->never())->method('addListener');
+
+    $manager = new MenuLinkRebuildManager($menuLinkManager, $eventDispatcher);
+    $manager->destruct();
+  }
+
+  /**
+   * Tests that requestRebuild() registers a 'kernel.response' listener.
+   *
+   * @covers ::requestRebuild
+   */
+  public function testRequestRebuildRegistersResponseListener(): void {
+    $menuLinkManager = $this->createMock(MenuLinkManagerInterface::class);
+    $eventDispatcher = $this->createMock(EventDispatcherInterface::class);
+    $eventDispatcher->expects($this->once())
+      ->method('addListener')
+      ->with(
+        KernelEvents::RESPONSE,
+        $this->callback(fn ($listener) => is_array($listener) && $listener[1] === 'onKernelResponse'),
+      );
+
+    $manager = new MenuLinkRebuildManager($menuLinkManager, $eventDispatcher);
+    $manager->requestRebuild();
+  }
+
+  /**
+   * Tests that repeated requests only register the listener once.
+   *
+   * This is what keeps the service cheap for the common case: the
+   * listener is only ever attached once per request, no matter how many
+   * tracked entities are saved.
+   *
+   * @covers ::requestRebuild
+   */
+  public function testRepeatedRebuildRequestsOnlyRegisterListenerOnce(): void {
+    $menuLinkManager = $this->createMock(MenuLinkManagerInterface::class);
+    $eventDispatcher = $this->createMock(EventDispatcherInterface::class);
+    $eventDispatcher->expects($this->once())->method('addListener');
+
+    $manager = new MenuLinkRebuildManager($menuLinkManager, $eventDispatcher);
+    for ($i = 0; $i < 50; $i++) {
+      $manager->requestRebuild();
+    }
+  }
+
+  /**
+   * Tests that a single rebuild request results in exactly one rebuild.
+   *
+   * @covers ::requestRebuild
+   * @covers ::destruct
+   */
+  public function testSingleRebuildRequestTriggersOneRebuild(): void {
+    $menuLinkManager = $this->createMock(MenuLinkManagerInterface::class);
+    $menuLinkManager->expects($this->once())->method('rebuild');
+    $eventDispatcher = $this->createMock(EventDispatcherInterface::class);
+
+    $manager = new MenuLinkRebuildManager($menuLinkManager, $eventDispatcher);
+    $manager->requestRebuild();
+    $manager->destruct();
+  }
+
+  /**
+   * Tests that multiple rebuild requests are coalesced into one rebuild.
+   *
+   * This is the core fix for issue #3385337: creating/updating/deleting
+   * many entities in a single request (e.g. during config import or bulk
+   * content creation) must trigger only a single menu link rebuild.
+   *
+   * @covers ::requestRebuild
+   * @covers ::destruct
+   */
+  public function testMultipleRebuildRequestsTriggerOnlyOneRebuild(): void {
+    $menuLinkManager = $this->createMock(MenuLinkManagerInterface::class);
+    $menuLinkManager->expects($this->once())->method('rebuild');
+    $eventDispatcher = $this->createMock(EventDispatcherInterface::class);
+
+    $manager = new MenuLinkRebuildManager($menuLinkManager, $eventDispatcher);
+    for ($i = 0; $i < 50; $i++) {
+      $manager->requestRebuild();
+    }
+    $manager->destruct();
+  }
+
+  /**
+   * Tests that calling destruct() twice only rebuilds once.
+   *
+   * The $needsRebuild flag is reset after a rebuild, so a second call to
+   * destruct() (e.g. a manual flush in a test, followed by the real
+   * kernel terminate event) does not trigger a redundant rebuild.
+   *
+   * @covers ::requestRebuild
+   * @covers ::destruct
+   */
+  public function testDestructResetsFlagAfterRebuild(): void {
+    $menuLinkManager = $this->createMock(MenuLinkManagerInterface::class);
+    $menuLinkManager->expects($this->once())->method('rebuild');
+    $eventDispatcher = $this->createMock(EventDispatcherInterface::class);
+
+    $manager = new MenuLinkRebuildManager($menuLinkManager, $eventDispatcher);
+    $manager->requestRebuild();
+    $manager->destruct();
+    $manager->destruct();
+  }
+
+  /**
+   * Tests that a rebuild can be requested again after a previous flush.
+   *
+   * Also confirms the listener is only ever registered once per manager
+   * instance, even across multiple request/flush cycles.
+   *
+   * @covers ::requestRebuild
+   * @covers ::destruct
+   */
+  public function testRebuildCanBeRequestedAgainAfterDestruct(): void {
+    $menuLinkManager = $this->createMock(MenuLinkManagerInterface::class);
+    $menuLinkManager->expects($this->exactly(2))->method('rebuild');
+    $eventDispatcher = $this->createMock(EventDispatcherInterface::class);
+    $eventDispatcher->expects($this->once())->method('addListener');
+
+    $manager = new MenuLinkRebuildManager($menuLinkManager, $eventDispatcher);
+    $manager->requestRebuild();
+    $manager->destruct();
+    $manager->requestRebuild();
+    $manager->destruct();
+  }
+
+  /**
+   * Tests that a main request response flushes a pending rebuild.
+   *
+   * This is what makes interactive form submissions (e.g. saving a role
+   * or menu) see fresh menu links on the very next page load: the
+   * rebuild now runs before the response is sent to the client, instead
+   * of racing with it via DestructableInterface.
+   *
+   * @covers ::onKernelResponse
+   */
+  public function testMainRequestResponseFlushesPendingRebuild(): void {
+    $menuLinkManager = $this->createMock(MenuLinkManagerInterface::class);
+    $menuLinkManager->expects($this->once())->method('rebuild');
+    $eventDispatcher = $this->createMock(EventDispatcherInterface::class);
+
+    $manager = new MenuLinkRebuildManager($menuLinkManager, $eventDispatcher);
+    $manager->requestRebuild();
+    $manager->onKernelResponse($this->createResponseEvent(self::MAIN_REQUEST));
+  }
+
+  /**
+   * Tests that a subrequest response does not flush a pending rebuild.
+   *
+   * @covers ::onKernelResponse
+   */
+  public function testSubRequestResponseDoesNotFlushPendingRebuild(): void {
+    $menuLinkManager = $this->createMock(MenuLinkManagerInterface::class);
+    $menuLinkManager->expects($this->never())->method('rebuild');
+    $eventDispatcher = $this->createMock(EventDispatcherInterface::class);
+
+    $manager = new MenuLinkRebuildManager($menuLinkManager, $eventDispatcher);
+    $manager->requestRebuild();
+    $manager->onKernelResponse($this->createResponseEvent(HttpKernelInterface::SUB_REQUEST));
+  }
+
+  /**
+   * Tests that destruct() is a safe no-op once kernel.response has flushed.
+   *
+   * Covers the CLI fallback path: onKernelResponse() (HTTP) and destruct()
+   * (kernel.terminate, always called for CLI/Drush) can both fire in the
+   * same request without triggering a second rebuild.
+   *
+   * @covers ::onKernelResponse
+   * @covers ::destruct
+   */
+  public function testDestructIsNoOpAfterKernelResponseFlushed(): void {
+    $menuLinkManager = $this->createMock(MenuLinkManagerInterface::class);
+    $menuLinkManager->expects($this->once())->method('rebuild');
+    $eventDispatcher = $this->createMock(EventDispatcherInterface::class);
+
+    $manager = new MenuLinkRebuildManager($menuLinkManager, $eventDispatcher);
+    $manager->requestRebuild();
+    $manager->onKernelResponse($this->createResponseEvent(self::MAIN_REQUEST));
+    $manager->destruct();
+  }
+
+  /**
+   * Tests that rebuildNow() rebuilds immediately, even without a request.
+   *
+   * @covers ::rebuildNow
+   */
+  public function testRebuildNowRebuildsImmediately(): void {
+    $menuLinkManager = $this->createMock(MenuLinkManagerInterface::class);
+    $menuLinkManager->expects($this->once())->method('rebuild');
+    $eventDispatcher = $this->createMock(EventDispatcherInterface::class);
+
+    $manager = new MenuLinkRebuildManager($menuLinkManager, $eventDispatcher);
+    $manager->rebuildNow();
+  }
+
+  /**
+   * Tests that rebuildNow() clears a pending request and rebuilds only once.
+   *
+   * @covers ::rebuildNow
+   * @covers ::destruct
+   */
+  public function testRebuildNowClearsPendingRequest(): void {
+    $menuLinkManager = $this->createMock(MenuLinkManagerInterface::class);
+    $menuLinkManager->expects($this->once())->method('rebuild');
+    $eventDispatcher = $this->createMock(EventDispatcherInterface::class);
+
+    $manager = new MenuLinkRebuildManager($menuLinkManager, $eventDispatcher);
+    $manager->requestRebuild();
+    $manager->rebuildNow();
+    // Neither the response listener nor the termination must rebuild again.
+    $manager->onKernelResponse($this->createResponseEvent(self::MAIN_REQUEST));
+    $manager->destruct();
+  }
+
+}
